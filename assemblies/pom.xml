<?xml version="1.0" encoding="UTF-8"?>
<!--
  Assemblies — Intermediate Aggregator
  ════════════════════════════════════
  Parent of every assembly module. The root POM lists only this module, so the
  root never changes when an assembly is added.

  MAINTENANCE: every ingest that creates an assembly adds a <subproject> entry
  below (the directory name under assemblies/). Keep `compendium` first.
  Assembly-specific plugin configuration, if any is ever needed, goes in this
  POM's <build><pluginManagement> so all assemblies inherit it.

  Build:
    mvn clean verify -pl assemblies -am                    # every assembly + topics
    mvn clean verify -pl assemblies/compendium -am         # one assembly + topics
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
         http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>dev.ikm.dex.docs</groupId>
        <artifactId>ike-dex-docs</artifactId>
    </parent>

    <artifactId>assemblies</artifactId>
    <packaging>pom</packaging>

    <name>Assemblies</name>
    <description>Aggregator for every assembly module.</description>

    <properties>
        <!-- Self-contained HTML (data-uri) is the portable HTML deliverable: the multi-page
             HTML links topic images by absolute path into target/. Rendered only for assemblies. -->
        <ike.skip.html-single>false</ike.skip.html-single>
    </properties>

    <subprojects>
        <subproject>compendium</subproject>
        <subproject>FA3-D1_Current-State_DeX_Production_Workflow_Overview</subproject>
    </subprojects>

</project>
